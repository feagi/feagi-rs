# Patch crates.io feagi-* dependencies to the sibling `feagi-core` workspace (monorepo layout).
#
# Paths assume `feagi-rs` and `feagi-core` are side-by-side (e.g. FEAGI-2.0/feagi-rs and FEAGI-2.0/feagi-core).
# Copy to `feagi-rs/.cargo/config.toml` if your checkout does not include it.
#
# Keep entries in sync with every `feagi-*` dependency in feagi-rs/Cargo.toml (dependencies + dev-dependencies).

[patch.crates-io]
feagi-api = { path = "../feagi-core/crates/feagi-api" }
feagi-io = { path = "../feagi-core/crates/feagi-io" }
feagi-services = { path = "../feagi-core/crates/feagi-services" }
feagi-config = { path = "../feagi-core/crates/feagi-config" }
feagi-structures = { path = "../feagi-core/crates/feagi-structures" }
feagi-observability = { path = "../feagi-core/crates/feagi-observability" }
feagi-agent = { path = "../feagi-core/crates/feagi-agent" }
feagi-sensorimotor = { path = "../feagi-core/crates/feagi-sensorimotor" }
feagi-state-manager = { path = "../feagi-core/crates/feagi-state-manager" }
feagi-brain-development = { path = "../feagi-core/crates/feagi-brain-development" }
feagi-evolutionary = { path = "../feagi-core/crates/feagi-evolutionary" }
feagi-npu-neural = { path = "../feagi-core/crates/feagi-npu/neural" }
feagi-npu-runtime = { path = "../feagi-core/crates/feagi-npu/runtime" }
feagi-npu-burst-engine = { path = "../feagi-core/crates/feagi-npu/burst-engine" }
feagi-npu-plasticity = { path = "../feagi-core/crates/feagi-npu/plasticity" }
feagi-serialization = { path = "../feagi-core/crates/feagi-serialization" }


